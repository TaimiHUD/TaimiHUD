#include <taimi_version.h>
#include <winver.h>

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#define VOS_NT 0x40000
#define VS_FFI_FILEFLAGSMASK 0x3f
#define VS_FF_DEBUG 1
#define VS_FF_PRERELEASE 2
#define VS_FF_PRIVATEBUILD 8
#define VS_FF_SPECIALBUILD 0x20
#endif

1 ICON CARGO_MANIFEST_DIR "/data/manifest/taimi32.ico"
#ifdef TAIMI_RC_SRC_MANIFEST
RT_MANIFEST TAIMI_RC_SRC_MANIFEST
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION TAIMI_VINFO_FILEVERSION_PARTS
PRODUCTVERSION TAIMI_VINFO_VERSION_PARTS
//FILETYPE (VFT_APP|VFT_DLL) :<
//FILESUBTYPE VFT2_UNKNOWN
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT
FILEFLAGS (
	0
#ifdef TAIMI_VINFO_IS_DEBUG
	| VS_FF_DEBUG
#endif
#ifdef TAIMI_VINFO_IS_PRE
	| VS_FF_PRERELEASE
#endif
#ifdef TAIMI_VINFO_PRIVATE
	| VS_FF_PRIVATEBUILD
#endif
#ifdef TAIMI_VINFO_SPECIAL
	| VS_FF_SPECIALBUILD
#endif
)
BEGIN
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1252
		// TODO? we technically could include supported i18n languages but only the FileDescription would differ...
	END
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904E4" // EN(0x409)+ANSI(1252)
		BEGIN
		VALUE "ProductName", TAIMI_VINFO_NAME
		VALUE "ProductVersion", TAIMI_VINFO_VERSION_NAME
		VALUE "CompanyName", TAIMI_VINFO_AUTHORS
		VALUE "OriginalFilename", TAIMI_VINFO_FILENAME
		VALUE "InternalName", TAIMI_VINFO_MODULENAME
		VALUE "FileDescription", TAIMI_VINFO_DESC
		VALUE "FileVersion", TAIMI_VINFO_FILEVERSION_NAME
#ifdef TAIMI_VINFO_ASSVERSION_NAME
		VALUE "Assembly Version", TAIMI_VINFO_ASSVERSION_NAME
#endif
#ifdef TAIMI_VINFO_PRIVATE
		VALUE "PrivateBuild", TAIMI_VINFO_PRIVATE
#endif
#ifdef TAIMI_VINFO_SPECIAL
		VALUE "SpecialBuild", TAIMI_VINFO_SPECIAL
#endif
		END
	END
END
